<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven 项目描述文件（pom.xml）
  作用：声明项目基本信息 + 所有第三方依赖（相当于 Node.js 的 package.json）
  常用命令：mvn compile 编译 / mvn spring-boot:run 启动（本项目用 ./mvnw，见 README）

  版本选型说明：
  - Spring Boot 3.5.16 是 Boot 3 系列的最终稳定版。官方脚手架 start.spring.io
    现在只提供 Boot 4（且 MyBatis 官方尚未适配 Boot 4），所以这里手写锁定 3.5.x。
  - mybatis-spring-boot-starter 3.0.5 是 MyBatis 官方适配 Spring Boot 3.5 的版本。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方父工程：统一管理依赖版本，绝大多数依赖无需手写版本号 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.dota</groupId>
    <artifactId>dota-guide-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>dota-guide-backend</name>
    <description>Dota 2 新手入门教学网站 - 后端</description>

    <properties>
        <!-- 编译目标 Java 版本 -->
        <java.version>17</java.version>
        <!-- 统一源码编码，保证中文注释和字符串不乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 1. Web 起步依赖：内置 Spring MVC + 内嵌 Tomcat，
             提供 @RestController、@GetMapping 等 REST 接口能力 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 2. MyBatis 起步依赖：把 MyBatis 接入 Spring Boot，
             接口上加 @Mapper 注解即可写 SQL（自带 JDBC + HikariCP 连接池） -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.5</version>
        </dependency>

        <!-- 3. MySQL JDBC 驱动：连接 MySQL 8 数据库
             （版本号由 Spring Boot 父工程统一管理，无需手写） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot 打包/运行插件：mvn spring-boot:run 就是靠它启动应用的 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
